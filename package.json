    "express": "^5.2.1"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "prisma": "^8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

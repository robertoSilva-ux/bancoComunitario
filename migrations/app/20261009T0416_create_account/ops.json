  {
    "id": "unique.Account.Account_document_key",
    "label": "Add unique constraint on \"Account\" (document)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Account_document_key",
